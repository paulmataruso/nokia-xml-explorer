# Copy this file to .env and adjust as needed. docker-compose reads .env
# automatically -- none of these are required, every one has a sane default.

# Host port to serve the app on (http://localhost:<PORT>).
PORT=8080

# Show the bundled sample commissioning files (example/) in the file list
# alongside your own. Set to false to only show your own scp/ + uploads.
INCLUDE_EXAMPLES=true

# Where your own commissioning files live on your machine (read-only).
SCP_HOST_DIR=./scp
# Where uploaded/generated files and edit-history snapshots are stored on
# your machine (writable -- survive container restarts).
UPLOADS_HOST_DIR=./uploads
SNAPSHOTS_HOST_DIR=./snapshots
# Site Management's folders/tags/site metadata (pure organization -- never
# the files themselves).
SITEMGMT_HOST_DIR=./sitemgmt

# Max size (MB) for a single file uploaded through the UI.
MAX_UPLOAD_MB=25
# How many snapshots to keep per file before the oldest are pruned.
MAX_SNAPSHOTS_PER_FILE=50

# Comma-separated allowed origins, or "*" for any. Only matters if you're
# exposing this beyond localhost (e.g. behind a reverse proxy).
CORS_ORIGINS=*
